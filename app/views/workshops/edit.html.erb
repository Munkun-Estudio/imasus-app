<% content_for :title, t(".title", workshop: @workshop.title) %>

<div class="px-6 py-12 sm:px-10 lg:px-16">
  <div class="max-w-3xl">
    <%= link_to workshop_path(@workshop),
                class: "inline-flex items-center text-sm text-brand-primary/60 hover:text-brand-primary" do %>
      <%= t(".back_to_workshop") %>
    <% end %>

    <h1 class="mt-2 text-3xl font-bold tracking-tight text-brand-primary sm:text-4xl">
      <%= t(".heading") %>
    </h1>
    <p class="mt-3 text-sm leading-relaxed text-brand-primary/60">
      <%= t(".lead") %>
    </p>

    <%= render "form",
               workshop: @workshop,
               form_url: workshop_path(@workshop),
               submit_label: t(".submit"),
               cancel_url: workshop_path(@workshop),
               cancel_label: t(".cancel") %>
  </div>
</div>
