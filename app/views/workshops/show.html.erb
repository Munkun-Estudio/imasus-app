<% content_for :title, @workshop.title %>
<% content_for :meta_description, @workshop.description %>

<div class="px-6 py-12 sm:px-10 lg:px-16">
  <%= link_to workshops_path,
              class: "inline-flex items-center text-sm font-semibold text-brand-primary/70 hover:text-brand-primary" do %>
    <%= t(".back_to_index") %>
  <% end %>

  <header class="mt-6 max-w-5xl">
    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-primary/50"><%= t(".eyebrow") %></p>
    <% if @attending %>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span class="rounded-full bg-brand-success/50 px-3 py-1 text-xs font-semibold text-brand-primary">
          <%= t(".attending") %>
        </span>
      </div>
    <% end %>

    <%# Title + Edit-workshop CTA inline. Edit hides for non-managers. %>
    <div class="mt-5 flex flex-wrap items-start justify-between gap-4">
      <h1 class="flex-1 text-4xl font-bold text-brand-primary"><%= @workshop.title %></h1>
      <div class="flex flex-wrap items-center gap-3">
        <% if current_user&.admin? %>
          <%= link_to t(".compose_email", default: "Compose email"),
                      new_admin_workshop_email_path(@workshop),
                      class: "shrink-0 inline-flex items-center rounded-full bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-secondary" %>
        <% end %>
        <% if @workshop.manageable_by?(current_user) %>
          <%= link_to t(".edit_workshop"),
                      edit_workshop_path(@workshop),
                      class: "shrink-0 inline-flex items-center rounded-full border border-brand-primary/20 px-5 py-2.5 text-sm font-semibold text-brand-primary hover:bg-brand-primary/5" %>
        <% end %>
      </div>
    </div>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-stone-700"><%= @workshop.description %></p>
  </header>

  <%# Unified card grid — Location / Dates always; Agenda for any logged-in
     user; Participants for managers (admin + workshop facilitators) and
     visiting facilitators (invite-only, no count). %>
  <% show_agenda_card = current_user.present? %>
  <% show_participants_card = @workshop.manageable_by?(current_user) || current_user&.facilitator? %>
  <div class="mt-10 grid max-w-5xl gap-5 border-t border-brand-primary/10 pt-8 sm:grid-cols-2">
    <article class="flex h-full flex-col rounded-2xl border border-brand-primary/10 bg-white p-6">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-primary/45">
        <%= t(".location") %>
      </p>
      <p class="mt-3 flex-1 text-base font-semibold leading-snug text-brand-primary">
        <%= @workshop.location %>
      </p>
    </article>

    <article class="flex h-full flex-col rounded-2xl border border-brand-primary/10 bg-white p-6">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-primary/45">
        <%= t(".dates") %>
      </p>
      <p class="mt-3 flex-1 text-base font-semibold leading-snug text-brand-primary">
        <%= workshop_date_range(@workshop) %>
      </p>
    </article>
    <% if show_agenda_card %>
        <article class="flex h-full flex-col rounded-2xl border border-brand-primary/10 bg-white p-6">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-primary/45">
            <%= t(".agenda") %>
          </p>
          <% agenda = @workshop.agenda_for(I18n.locale) %>
          <% if agenda&.body&.to_plain_text.to_s.strip.present? %>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-brand-primary/70">
              <%= truncate(agenda.body.to_plain_text, length: 220) %>
            </p>
          <% else %>
            <p class="mt-3 flex-1 text-sm italic leading-relaxed text-brand-primary/45">
              <%= t(".agenda_empty") %>
            </p>
          <% end %>
          <%= link_to t(".agenda_page"),
                      agenda_workshop_path(@workshop),
                      class: "mt-4 inline-flex w-fit items-center rounded-full border border-brand-primary/20 px-4 py-2 text-sm font-semibold text-brand-primary hover:bg-brand-primary/5" %>
        </article>
      <% end %>

      <% if show_participants_card %>
        <article class="flex h-full flex-col rounded-2xl border border-brand-primary/10 bg-white p-6">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-primary/45">
            <%= t(".participants") %>
          </p>
          <% if @workshop.manageable_by?(current_user) %>
            <% count = @workshop.participants.count(&:participant?) %>
            <%= link_to t(".participant_count", count: count),
                        workshop_participants_path(@workshop),
                        class: "mt-3 flex-1 text-2xl font-bold text-brand-primary hover:underline" %>
          <% else %>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-brand-primary/60">
              <%= t(".participants_invite_only") %>
            </p>
          <% end %>
          <%= link_to t(".invite_participants"),
                      new_workshop_invitation_path(@workshop),
                      class: "mt-4 inline-flex w-fit items-center rounded-full border border-brand-primary/20 px-4 py-2 text-sm font-semibold text-brand-primary hover:bg-brand-primary/5" %>
        </article>
      <% end %>
  </div>

  <% if current_user %>
    <%= render "projects",
               workshop: @workshop,
               projects: @projects,
               attending: @attending,
               user_project_ids: @user_project_ids %>
  <% else %>
    <%= render "published_projects",
               workshop: @workshop,
               projects: @published_projects %>
  <% end %>
</div>
