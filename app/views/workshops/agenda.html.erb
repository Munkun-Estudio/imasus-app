<% content_for :title, t(".title", workshop: @workshop.title) %>
<% content_for :meta_description, @workshop.description %>

<div class="px-6 py-12 sm:px-10 lg:px-16">
  <%= link_to workshop_path(@workshop),
              class: "inline-flex items-center text-sm font-semibold text-brand-primary/70 hover:text-brand-primary" do %>
    <%= t(".back_to_workshop") %>
  <% end %>

  <header class="mt-6 max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-primary/50"><%= t(".eyebrow") %></p>
    <h1 class="mt-3 text-4xl font-bold text-brand-primary"><%= t(".title", workshop: @workshop.title) %></h1>
    <p class="mt-3 text-base font-semibold text-stone-700"><%= workshop_date_range(@workshop) %></p>
  </header>

  <div class="mt-10 max-w-3xl border-t border-brand-primary/10 pt-8">
    <%= workshop_agenda(@workshop) %>
  </div>
</div>
