<%# locals: (challenge:, mode: :preview) %>
<%
  accent_class = case challenge.category
                 when "material" then "border-l-brand-primary"
                 when "design"   then "border-l-brand-secondary"
                 when "system"   then "border-l-brand-info"
                 when "business" then "border-l-brand-soft"
                 else                 "border-l-brand-primary/20"
                 end
  pill_class = case challenge.category
               when "material" then "bg-brand-primary/10 text-brand-primary"
               when "design"   then "bg-brand-secondary/10 text-brand-secondary"
               when "system"   then "bg-brand-info/30 text-brand-primary"
               when "business" then "bg-brand-soft/40 text-brand-primary"
               else                 "bg-brand-primary/10 text-brand-primary"
               end

  public_mode = mode == :public
  link_target = public_mode ? challenges_path : preview_challenge_path(challenge.to_param)
  link_data   = public_mode ? {} : { turbo_frame: "preview" }

  card = capture do %>
  <article id="<%= challenge.code.downcase %>"
           data-challenge="<%= challenge.code %>"
           class="group relative flex h-full flex-col gap-3 rounded-lg border border-brand-primary/10 border-l-4 <%= accent_class %> bg-white p-5 shadow-sm transition hover:shadow-md focus-within:ring-2 focus-within:ring-brand-primary/40">
    <% if logged_in? && !public_mode %>
      <div class="absolute right-2 top-2 z-10">
        <%= bookmark_toggle(
              bookmarkable_type: "Challenge",
              resource_key:      challenge.code,
              label:             "#{challenge.code} – #{challenge.question.truncate(100)}",
              url:               "#{challenges_path}##{challenge.code.downcase}") %>
      </div>
    <% end %>
    <div class="flex items-center gap-2 text-xs">
      <span class="font-mono font-semibold text-brand-primary">
        <%= challenge.code %>
      </span>
      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 font-medium <%= pill_class %>">
        <%= t("challenges.categories.#{challenge.category}") %>
      </span>
    </div>

    <h3 class="text-base font-semibold text-brand-primary">
      <%= link_to link_target,
            aria: { label: t("challenges.card.open_label", code: challenge.code) },
            data: link_data,
            class: "before:absolute before:inset-0 before:z-0 before:content-[''] focus:outline-none hover:underline" do %>
        <%= challenge.question %>
      <% end %>
    </h3>

    <% if curator? && !public_mode %>
      <div class="mt-auto flex justify-end">
        <%= link_to t("challenges.actions.edit"),
              edit_challenge_path(challenge.to_param),
              data: { role: "edit-challenge", turbo_frame: dom_id(challenge) },
              class: "relative z-10 rounded-md border border-brand-primary/20 px-3 py-1 text-xs font-medium text-brand-primary hover:bg-brand-success/20" %>
      </div>
    <% end %>
  </article>
<% end %>
<% if public_mode %>
  <%= card %>
<% else %>
  <%= turbo_frame_tag dom_id(challenge) do %><%= card %><% end %>
<% end %>
