<% content_for :title, library_module_label %>
<% if @any_filters_active %>
  <% content_for :head do %>
    <meta name="robots" content="noindex,nofollow">
  <% end %>
<% end %>

<div class="px-6 py-12 sm:px-10 lg:px-16">
  <header class="max-w-3xl">
    <h1 class="text-3xl font-bold text-brand-primary"><%= library_module_label %></h1>
    <p class="mt-3 text-base text-brand-primary/70"><%= t("library_items.index.lead") %></p>
  </header>

  <%= form_with url: library_path, method: :get, local: true,
        class: "mt-8 max-w-xl", data: { turbo: "false" } do |form| %>
    <% @selected_taxonomies.each do |taxonomy, slugs| %>
      <%= form.hidden_field taxonomy, value: slugs.join(",") %>
    <% end %>
    <% if @selected_item_types.any? %>
      <%= form.hidden_field :type, value: @selected_item_types.join(",") %>
    <% end %>
    <%= form.label :q, t("library_items.index.search_label"), class: "sr-only" %>
    <%= form.search_field :q,
          value: @query,
          placeholder: t("library_items.index.search_placeholder"),
          autocomplete: "off",
          class: "w-full rounded-md border border-brand-primary/20 bg-white px-4 py-2 text-sm text-brand-primary placeholder:text-brand-primary/40 focus:border-brand-primary focus:outline-none" %>
  <% end %>

  <% if @any_filters_active %>
    <div class="mt-8">
      <%= link_to t("library_items.index.clear_all"), library_path,
            data: { role: "clear-all" },
            class: "inline-flex items-center rounded-full border border-brand-primary/20 bg-white px-4 py-1.5 text-sm font-medium text-brand-primary hover:bg-brand-success/20" %>
    </div>
  <% end %>

  <section class="mt-6 space-y-6" aria-label="<%= t("library_items.index.filters_label") %>">
    <% if LibraryCatalog.current.item_types.many? %>
      <div data-filter="item-type">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-brand-primary/60">
          <%= t("library_items.index.item_types") %>
        </h2>
        <ul class="mt-2 flex flex-wrap gap-2">
          <% LibraryCatalog.current.item_types.each do |item_type| %>
            <% active = @selected_item_types.include?(item_type.id) %>
            <li>
              <%= link_to library_type_toggle_url(item_type.id, selected: @selected_item_types, taxonomies: @selected_taxonomies, query: @query),
                    rel: "nofollow",
                    class: "inline-flex items-center rounded-full px-4 py-1.5 text-sm font-medium #{active ? "bg-brand-primary text-white" : "border border-brand-primary/20 bg-white text-brand-primary hover:bg-brand-success/20"}" do %>
                <%= library_item_type_label(item_type) %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% @filter_taxonomies.each do |taxonomy| %>
      <% terms = @terms_by_taxonomy.fetch(taxonomy.id, []) %>
      <% next if terms.empty? %>
      <div data-taxonomy="<%= taxonomy.id %>">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-brand-primary/60">
          <%= library_taxonomy_label(taxonomy) %>
        </h2>
        <ul class="mt-2 flex flex-wrap gap-2">
          <% terms.each do |term| %>
            <% active = library_filter_active?(taxonomy.id, term.slug, selected: @selected_taxonomies) %>
            <% count = @generic_chip_counts[term.id] || 0 %>
            <% next if count.zero? && !active %>
            <li>
              <%= link_to library_filter_toggle_url(taxonomy.id, term.slug, selected: @selected_taxonomies, item_types: @selected_item_types, query: @query),
                    rel: "nofollow", data: { "term-slug" => term.slug },
                    class: "inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm font-medium #{active ? "bg-brand-primary text-white" : "border border-brand-primary/20 bg-white text-brand-primary hover:bg-brand-success/20"}" do %>
                <span><%= library_term_label(term) %></span>
                <span class="text-xs <%= active ? "text-white/80" : "text-brand-primary/60" %>"><%= count %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>

  <% if @library_items.empty? %>
    <p data-role="empty-state" class="mt-12 text-brand-primary/60"><%= t("library_items.index.empty_state") %></p>
  <% else %>
    <div id="library-grid" role="list" class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @library_items.each_with_index do |library_item, index| %>
        <div role="listitem">
          <%= render "library_items/card", library_item:, priority: index.zero? && @page == 1 %>
        </div>
      <% end %>
      <%= render "library_items/next_page", next_page: @next_page %>
    </div>
  <% end %>
</div>
