<%# locals: (library_item:) %>
<%= turbo_frame_tag "preview" do %>
  <% cover_asset = library_item.cover_asset %>
  <div data-controller="preview-sidebar" data-action="click->preview-sidebar#backdrop keydown.esc@window->preview-sidebar#close"
       class="fixed inset-0 z-40 flex items-end justify-end bg-brand-primary/20 sm:items-stretch">
    <aside role="dialog" aria-modal="false" aria-labelledby="preview-heading-<%= library_item.slug %>" tabindex="-1"
           data-preview-sidebar-target="dialog" class="flex h-[85vh] w-full flex-col overflow-y-auto rounded-t-2xl bg-white shadow-xl sm:h-screen sm:max-w-md sm:rounded-none">
      <header class="flex items-start justify-between gap-4 border-b border-brand-primary/10 px-6 py-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-primary/50"><%= library_item_type_label(library_item) %></p>
          <h2 id="preview-heading-<%= library_item.slug %>" class="mt-1 text-xl font-bold text-brand-primary"><%= library_item.title %></h2>
        </div>
        <button type="button" data-action="preview-sidebar#close" aria-label="<%= t("library_items.preview.close") %>"
                class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-brand-primary/70 hover:bg-brand-success/20"><span aria-hidden="true">&times;</span></button>
      </header>
      <% if cover_asset&.file&.attached? %>
        <div class="aspect-[4/3] w-full bg-brand-success/20"><%= image_variant_tag cover_asset.file, preset: :detail, alt: cover_asset.alt_text, class: "h-full w-full object-cover" %></div>
      <% end %>
      <div class="flex flex-col gap-4 px-6 py-5">
        <% if library_item.summary.present? %><p class="text-sm leading-relaxed text-brand-primary/80"><%= library_item.summary %></p><% end %>
        <% library_card_fields(library_item).each do |field, value| %>
          <div class="text-sm"><p class="text-xs font-semibold uppercase tracking-wide text-brand-primary/50"><%= library_field_label(field) %></p><div class="mt-1 text-brand-primary/80"><%= render_library_field(field, value, compact: true) %></div></div>
        <% end %>
        <%= link_to t("library_items.preview.open_full_page"), library_item_path(library_item), data: { turbo_frame: "_top" },
              class: "mt-2 inline-flex items-center self-start rounded-md bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:bg-brand-primary/90" %>
      </div>
    </aside>
  </div>
<% end %>
