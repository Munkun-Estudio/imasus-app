<%# locals: (library_item:, priority: false) %>
<% cover_asset = library_item.cover_asset %>
<article data-library-item="<%= library_item.slug %>"
         class="group relative flex h-full flex-col overflow-hidden rounded-lg border border-brand-primary/10 bg-white shadow-sm transition hover:shadow-md focus-within:ring-2 focus-within:ring-brand-primary/40">
  <div class="relative aspect-[4/3] overflow-hidden bg-brand-success/20">
    <% if cover_asset&.file&.attached? %>
      <%= image_variant_tag cover_asset.file, preset: :card, alt: cover_asset.alt_text,
            loading: priority ? "eager" : "lazy", fetchpriority: priority ? "high" : "auto",
            class: "h-full w-full object-cover" %>
    <% else %>
      <div class="flex h-full flex-col justify-between p-5 text-brand-primary/70">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-primary/45"><%= t("library_items.card.media_pending") %></p>
        <p class="max-w-[12rem] text-sm font-semibold leading-5 text-brand-primary"><%= library_item_type_label(library_item) %></p>
      </div>
    <% end %>

    <%= link_to preview_library_item_path(library_item),
          data: { role: "open-preview", turbo_frame: "preview" },
          aria: { label: t("library_items.preview.open_label", name: library_item.title) },
          class: "absolute right-2 top-2 z-10 inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-brand-primary shadow-sm hover:bg-white focus:outline-none focus:ring-2 focus:ring-brand-primary/40" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
        <circle cx="12" cy="12" r="3" />
      </svg>
    <% end %>
  </div>

  <div class="flex flex-1 flex-col gap-3 p-4">
    <p class="text-xs font-semibold uppercase tracking-wide text-brand-primary/50"><%= library_item_type_label(library_item) %></p>
    <h2 class="text-base font-semibold text-brand-primary">
      <%= link_to library_item.title, library_item_path(library_item), data: { turbo_frame: "_top" },
            aria: { label: t("library_items.show.view_detail", name: library_item.title) },
            class: "before:absolute before:inset-0 before:z-0 before:content-[''] focus:outline-none" %>
    </h2>
    <% if library_item.summary.present? %>
      <p class="line-clamp-3 text-sm leading-relaxed text-brand-primary/70"><%= library_item.summary %></p>
    <% end %>
    <% if library_card_fields(library_item).any? %>
      <dl class="relative z-10 mt-auto space-y-2 border-t border-brand-primary/10 pt-3 text-xs">
        <% library_card_fields(library_item).each do |field, value| %>
          <div class="flex gap-2">
            <dt class="font-semibold text-brand-primary/60"><%= library_field_label(field) %></dt>
            <dd class="text-brand-primary/80"><%= render_library_field(field, value, compact: true) %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>
  </div>
</article>
