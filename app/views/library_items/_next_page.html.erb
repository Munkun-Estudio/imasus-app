<%# locals: (next_page:) %>
<% if next_page %>
  <%= turbo_frame_tag "library_page_#{next_page}", src: library_path(request.query_parameters.merge(page: next_page)),
        loading: "lazy", data: { role: "library-next-page", controller: "lazy-frame" }, class: "col-span-full block min-h-16" do %>
    <span class="sr-only"><%= t("library_items.index.loading_more") %></span>
  <% end %>
<% end %>
