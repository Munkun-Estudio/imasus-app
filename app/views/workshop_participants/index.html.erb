<% content_for :title, t(".title", workshop: @workshop.title) %>

<div class="px-6 py-12 sm:px-10 lg:px-16">
  <div class="max-w-5xl">
    <%= link_to workshop_path(@workshop),
                class: "inline-flex items-center text-sm font-semibold text-brand-primary/70 hover:text-brand-primary" do %>
      <%= t(".back_to_workshop") %>
    <% end %>

    <h1 class="mt-2 text-3xl font-bold tracking-tight text-brand-primary sm:text-4xl">
      <%= t(".heading", workshop: @workshop.title) %>
    </h1>
    <p class="mt-3 text-sm leading-relaxed text-brand-primary/60">
      <%= t(".lead") %>
    </p>

    <% if flash[:notice].present? %>
      <p class="mt-6 rounded-2xl bg-brand-success/40 px-4 py-3 text-sm text-brand-primary">
        <%= flash[:notice] %>
      </p>
    <% end %>
    <% if flash[:alert].present? %>
      <p class="mt-6 rounded-2xl bg-brand-accent/10 px-4 py-3 text-sm text-brand-accent">
        <%= flash[:alert] %>
      </p>
    <% end %>

    <% if @participations.empty? %>
      <p class="mt-8 rounded-2xl border border-dashed border-brand-primary/15 bg-white px-6 py-10 text-sm leading-relaxed text-brand-primary/60">
        <%= t(".empty") %>
      </p>
    <% else %>
      <ul class="mt-8 divide-y divide-brand-primary/10 rounded-2xl border border-brand-primary/10 bg-white">
        <% @participations.each do |participation| %>
          <% user = participation.user %>
          <% project_titles = @project_titles_by_user_id.fetch(user.id, []) %>
          <% removable = user.id != current_user.id && !user.admin? %>
          <% accepted = user.invitation_accepted_at.present? || user.password_digest.present? %>
          <li data-participant-row data-user-id="<%= user.id %>"
              class="flex flex-wrap items-center gap-4 px-5 py-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-primary text-sm font-bold text-white">
              <%= user.name.to_s.split.map { |part| part[0] }.join.upcase[0, 2] %>
            </span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-bold text-brand-primary"><%= user.name %></p>
              <p class="truncate text-xs text-brand-primary/60"><%= user.email %></p>
              <% if user.institution.present? || user.country.present? %>
                <p class="mt-1 text-xs text-brand-primary/60">
                  <%= [ user.institution, user.country ].compact_blank.join(" · ") %>
                </p>
              <% end %>
              <% if project_titles.any? %>
                <p class="mt-1 text-xs text-brand-primary/60">
                  <%= t(".projects", count: project_titles.size) %>:
                  <%= project_titles.join(" · ") %>
                </p>
              <% end %>
            </div>
            <div class="flex flex-col items-end gap-2 text-right text-xs text-brand-primary/50">
              <span data-participant-status="<%= accepted ? "accepted" : "pending" %>"
                    class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-bold <%= accepted ? "bg-brand-success/40 text-brand-primary" : "bg-brand-soft/50 text-brand-primary" %>">
                <%= t(".status.#{accepted ? "accepted" : "pending"}") %>
              </span>
              <span><%= t(".joined_on", date: l(participation.created_at.to_date)) %></span>
            </div>
            <% if removable %>
              <%= button_to workshop_participant_path(@workshop, user_id: user.id),
                            method: :delete,
                            data: { turbo_confirm: t(".confirm_remove", name: user.name) },
                            class: "inline-flex items-center rounded-full border border-brand-accent/30 px-3 py-1.5 text-xs font-bold text-brand-accent transition hover:bg-brand-accent/10" do %>
                <%= t(".remove") %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
