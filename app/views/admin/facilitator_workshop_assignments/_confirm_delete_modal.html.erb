<%= turbo_frame_tag "modal" do %>
  <div data-controller="modal"
       data-action="keydown.esc@window->modal#close click->modal#backdrop"
       class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
    <div role="dialog"
         aria-modal="true"
         aria-labelledby="confirm-unassign-title"
         tabindex="-1"
         data-modal-target="dialog"
         class="w-full max-w-md rounded-xl bg-white p-6 shadow-xl">
      <h2 id="confirm-unassign-title" class="text-lg font-semibold text-brand-primary">
        <%= t("admin.facilitator_workshop_assignments.delete_confirmation.title",
              default: "Unassign workshop?") %>
      </h2>
      <p class="mt-2 text-sm text-brand-primary/80">
        <%= t("admin.facilitator_workshop_assignments.delete_confirmation.body",
              default: "%{name} will lose edit access to %{workshop}. Their existing data stays.",
              name: facilitator.name,
              workshop: participation.workshop.title) %>
      </p>

      <div class="mt-6 flex items-center justify-end gap-2">
        <button type="button"
                data-action="modal#close"
                data-role="cancel-unassign-workshop"
                class="rounded-md border border-brand-primary/20 px-4 py-2 text-sm font-medium text-brand-primary hover:bg-brand-success/20">
          <%= t("admin.facilitator_workshop_assignments.delete_confirmation.cancel",
                default: "Cancel") %>
        </button>

        <%= button_to t("admin.facilitator_workshop_assignments.delete_confirmation.submit",
                        default: "Unassign"),
              admin_facilitator_workshop_assignment_path(facilitator, participation),
              method: :delete,
              form: { data: { turbo_frame: "_top" } },
              data: { role: "confirm-unassign-workshop" },
              class: "rounded-md bg-brand-accent px-4 py-2 text-sm font-semibold text-white hover:bg-brand-accent/90" %>
      </div>
    </div>
  </div>
<% end %>
