<% content_for :title, @facilitator.name %>

<% accepted = @facilitator.invitation_accepted_at.present? %>

<div class="px-6 py-12 sm:px-10 lg:px-16">
  <div class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-imasus-dark-green/50">
      <%= t("admin.facilitators.show.eyebrow", default: "Facilitator") %>
    </p>
    <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-imasus-dark-green sm:text-4xl">
          <%= @facilitator.name %>
        </h1>
        <p class="mt-1 text-sm text-imasus-dark-green/60"><%= @facilitator.email %></p>
      </div>
      <% if accepted %>
        <span data-status="active"
              class="inline-flex items-center rounded-full bg-imasus-mint/40 px-3 py-1 text-xs font-semibold text-imasus-dark-green">
          <%= t("admin.facilitators.index.active", default: "Active") %>
        </span>
      <% else %>
        <span data-status="pending"
              class="inline-flex items-center rounded-full bg-imasus-light-pink/40 px-3 py-1 text-xs font-semibold text-imasus-dark-green">
          <%= t("admin.facilitators.index.pending", default: "Invitation pending") %>
        </span>
      <% end %>
    </div>

    <% if flash[:notice].present? %>
      <p class="mt-6 rounded-2xl bg-imasus-mint/40 px-4 py-3 text-sm text-imasus-dark-green">
        <%= flash[:notice] %>
      </p>
    <% end %>
    <% if flash[:alert].present? %>
      <p class="mt-6 rounded-2xl bg-imasus-light-pink/60 px-4 py-3 text-sm text-imasus-dark-green">
        <%= flash[:alert] %>
      </p>
    <% end %>

    <section class="mt-10">
      <h2 class="text-lg font-semibold text-imasus-dark-green">
        <%= t("admin.facilitators.show.assigned_workshops", default: "Assigned workshops") %>
      </h2>

      <% if @assigned_participations.any? %>
        <ul class="mt-4 divide-y divide-imasus-dark-green/10 rounded-2xl border border-imasus-dark-green/10 bg-white">
          <% @assigned_participations.each do |participation| %>
            <% workshop = participation.workshop %>
            <li data-assigned-workshop data-workshop-id="<%= workshop.id %>"
                class="flex flex-wrap items-center gap-4 px-5 py-4">
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-bold text-imasus-dark-green"><%= workshop.title %></p>
                <p class="truncate text-xs text-imasus-dark-green/60"><%= workshop.location %></p>
              </div>
              <%= link_to t("admin.facilitators.show.unassign", default: "Unassign"),
                          delete_confirmation_admin_facilitator_workshop_assignment_path(@facilitator, participation),
                          data: { turbo_frame: "modal" },
                          class: "inline-flex shrink-0 items-center rounded-full border border-imasus-dark-green/20 px-4 py-1.5 text-xs font-semibold text-imasus-dark-green hover:bg-imasus-mint/20" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-4 rounded-2xl border border-dashed border-imasus-dark-green/15 bg-white px-6 py-6 text-sm text-imasus-dark-green/60">
          <%= t("admin.facilitators.show.no_workshops", default: "This facilitator is not yet assigned to any workshop.") %>
        </p>
      <% end %>
    </section>

    <% unless accepted %>
      <section class="mt-10 rounded-2xl border border-imasus-light-pink/40 bg-imasus-light-pink/10 px-6 py-5">
        <h2 class="text-base font-semibold text-imasus-dark-green">
          <%= t("admin.facilitators.show.revoke_section_title", default: "Pending invitation") %>
        </h2>
        <p class="mt-1 text-sm text-imasus-dark-green/70">
          <%= t("admin.facilitators.show.revoke_section_lead",
                default: "If this invitation was sent in error, revoke it to remove the facilitator account.") %>
        </p>
        <%= link_to t("admin.facilitators.show.revoke", default: "Revoke invitation"),
                    revoke_confirmation_admin_facilitator_path(@facilitator),
                    data: { turbo_frame: "modal" },
                    class: "mt-3 inline-flex items-center rounded-full border border-imasus-red/40 px-4 py-1.5 text-xs font-semibold text-imasus-red hover:bg-imasus-red/10" %>
      </section>
    <% end %>

    <% if @assignable_workshops.any? %>
      <section class="mt-10">
        <h2 class="text-lg font-semibold text-imasus-dark-green">
          <%= t("admin.facilitators.show.assign_workshop", default: "Assign a workshop") %>
        </h2>
        <%= form_with url: admin_facilitator_workshop_assignments_path(@facilitator),
                      method: :post,
                      class: "mt-4 flex flex-wrap items-center gap-3" do |f| %>
          <%= f.select :workshop_id,
                       @assignable_workshops.map { |w| [ "#{w.title} — #{w.location}", w.id ] },
                       {},
                       class: "min-w-0 flex-1 rounded-full border border-imasus-dark-green/20 bg-white px-4 py-2 text-sm" %>
          <%= f.submit t("admin.facilitators.show.assign", default: "Assign"),
                       class: "inline-flex shrink-0 items-center rounded-full bg-imasus-dark-green px-5 py-2.5 text-sm font-semibold text-white" %>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
