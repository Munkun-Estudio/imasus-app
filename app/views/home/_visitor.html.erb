<div data-home-variant="visitor" class="px-6 py-12 sm:px-10 lg:px-16 lg:py-16">
  <%# Hero band %>
  <section class="max-w-3xl">
    <p class="text-xs font-bold uppercase tracking-widest text-brand-primary/50">
      <%= t(".hero.eyebrow") %>
    </p>

    <h1 class="mt-4 text-4xl font-bold leading-[1.1] tracking-tight text-brand-primary sm:text-5xl lg:text-6xl">
      <%= t(".hero.heading") %>
    </h1>

    <p class="mt-8 max-w-xl text-base leading-relaxed text-brand-primary/60">
      <%= t(".hero.lead") %>
    </p>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="#workshops"
         class="inline-flex items-center rounded-full bg-brand-primary px-5 py-2.5 text-sm font-bold text-white transition hover:bg-brand-secondary">
        <%= t(".hero.see_workshops") %>
      </a>
      <a href="<%= new_session_path %>"
         class="inline-flex items-center rounded-full border border-brand-primary/15 px-5 py-2.5 text-sm font-bold text-brand-primary transition hover:border-brand-primary/30">
        <%= t(".hero.log_in") %>
      </a>
    </div>
  </section>

  <%# Why / How / What — explainer band %>
  <section data-home-section="explainer" class="mt-20">
    <p class="text-xs font-bold uppercase tracking-widest text-brand-primary/50">
      <%= t(".explainer.eyebrow") %>
    </p>

    <%
      pillar_styles = {
        why:  "bg-brand-success/40",
        how:  "bg-brand-info/30",
        what: "bg-brand-soft/40"
      }
    %>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% pillar_styles.each do |pillar, bg_class| %>
        <article data-explainer-card data-pillar="<%= pillar %>"
                 class="flex flex-col rounded-2xl border border-brand-primary/10 p-6 <%= bg_class %>">
          <p class="text-xs font-bold uppercase tracking-widest text-brand-primary/50">
            <%= t(".explainer.#{pillar}.eyebrow") %>
          </p>
          <h3 class="mt-3 text-lg font-bold leading-snug text-brand-primary">
            <%= t(".explainer.#{pillar}.heading") %>
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-brand-primary/70">
            <%= t(".explainer.#{pillar}.lead") %>
          </p>
        </article>
      <% end %>
    </div>
  </section>

  <%# The Imagineering Loom — diagram of how a workshop moves %>
  <section data-home-section="imagineering-loom" class="mt-20">
    <p class="text-xs font-bold uppercase tracking-widest text-brand-primary/50">
      <%= t(".loom.eyebrow") %>
    </p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-brand-primary sm:text-3xl">
      <%= t(".loom.heading") %>
    </h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-brand-primary/60">
      <%= t(".loom.lead") %>
    </p>

    <div class="mt-10">
      <%= image_tag "loom.png",
                    alt: t(".loom.diagram_alt"),
                    class: "mx-auto h-auto w-full max-w-4xl" %>
    </div>
  </section>

  <%# Workshops %>
  <section id="workshops" class="mt-20">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary sm:text-3xl">
      <%= t(".workshops.heading") %>
    </h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-brand-primary/60">
      <%= t(".workshops.lead") %>
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @workshops.each do |workshop| %>
        <article data-workshop-card data-slug="<%= workshop.slug %>"
                 class="flex flex-col rounded-2xl border border-brand-primary/10 bg-white p-6">
          <h3 class="text-lg font-bold text-brand-primary">
            <%= link_to workshop.title, workshop_path(workshop), class: "hover:underline" %>
          </h3>
          <p class="mt-1 text-xs font-medium uppercase tracking-wide text-brand-primary/50">
            <%= workshop.location %>
          </p>
          <% if workshop.starts_on.present? %>
            <p class="mt-2 text-xs text-brand-primary/60">
              <%= l(workshop.starts_on, format: :long) %>
              <% if workshop.ends_on.present? && workshop.ends_on != workshop.starts_on %>
                – <%= l(workshop.ends_on, format: :long) %>
              <% end %>
            </p>
          <% end %>
          <% if workshop.description.present? %>
            <p class="mt-3 text-sm leading-relaxed text-brand-primary/70 line-clamp-4">
              <%= workshop.description %>
            </p>
          <% end %>

          <div class="mt-4 flex flex-wrap gap-2">
            <%= link_to workshop_path(workshop),
                        class: "inline-flex items-center rounded-full border border-brand-primary/15 px-3 py-1.5 text-xs font-bold text-brand-primary transition hover:border-brand-primary/30" do %>
              <%= t(".workshops.see_workshop") %>
            <% end %>
            <% if workshop.contact_email.present? %>
              <%# TODO(request-a-spot): consider replacing with a real form scoped to this workshop. %>
              <a href="mailto:<%= workshop.contact_email %>"
                 class="inline-flex items-center rounded-full bg-brand-success px-3 py-1.5 text-xs font-bold text-brand-primary transition hover:brightness-95">
                <%= t(".workshops.request_spot") %>
              </a>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  </section>

  <%# Featured published projects %>
  <section class="mt-20">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary sm:text-3xl">
      <%= t(".featured_projects.heading") %>
    </h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-brand-primary/60">
      <%= t(".featured_projects.lead") %>
    </p>

    <% if @featured_projects.any? %>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% @featured_projects.each do |project| %>
          <%= link_to published_project_path(slug: project.slug),
                      data: { featured_project: true },
                      class: "group flex flex-col rounded-2xl border border-brand-primary/10 bg-white p-6 transition hover:border-brand-primary/30" do %>
            <h3 class="text-base font-bold text-brand-primary group-hover:underline">
              <%= project.title %>
            </h3>
            <% if project.workshop %>
              <p class="mt-1 text-xs font-medium uppercase tracking-wide text-brand-primary/50">
                <%= project.workshop.title %>
              </p>
            <% end %>
            <% if project.publication_updated_at %>
              <p class="mt-2 text-xs text-brand-primary/50">
                <%= l(project.publication_updated_at.to_date, format: :long) %>
              </p>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div data-featured-projects-empty
           class="mt-8 rounded-2xl border border-dashed border-brand-primary/15 bg-white px-6 py-10 text-sm leading-relaxed text-brand-primary/60">
        <%= t(".featured_projects.empty") %>
      </div>
    <% end %>
  </section>

  <%# Public resources teaser %>
  <section class="mt-20">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary sm:text-3xl">
      <%= t(".resources.heading") %>
    </h2>

    <div class="mt-8">
      <%= render "shared/resources_grid" %>
    </div>
  </section>
</div>
