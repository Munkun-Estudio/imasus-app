<%# Locals: current (String, "about" or a guide slug), modules (ModuleInfo objects).
    Renders the tab strip used at the top of every training surface — the
    landing About tab plus one tab per module. Same widget on the index
    (training#index) and on each section (training#show). %>
<nav class="mb-8 flex flex-wrap gap-2" aria-label="<%= t("training.show.module_nav_label", module: resource_module_label(@guides_module)) %>">
  <% about_active = current == "about" %>
  <%= link_to t("training.about.tab"),
        training_index_path,
        class: "rounded-full px-4 py-1.5 text-sm font-bold transition #{about_active ? 'bg-brand-primary text-white' : 'border border-brand-primary/15 text-brand-primary/60 hover:border-brand-primary/30'}" %>
  <% modules.each do |guide| %>
    <% active = guide.slug == current %>
    <%= link_to guide.title,
          training_show_path(slug: guide.slug, section: guide.available_sections.first),
          class: "rounded-full px-4 py-1.5 text-sm font-bold transition #{active ? 'bg-brand-primary text-white' : 'border border-brand-primary/15 text-brand-primary/60 hover:border-brand-primary/30'}" %>
  <% end %>
</nav>
