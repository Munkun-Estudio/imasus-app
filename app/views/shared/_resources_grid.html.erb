<%# Reusable resource grid driven by the enabled installation modules. %>
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <% resource_module_registry.enabled.each do |resource_module| %>
    <% dark = swatch_dark_bg?(resource_module.color) %>
    <%= link_to resource_module_path(resource_module),
          data: { resource_card: true, resource: resource_module.legacy_key },
          class: "rounded-2xl border p-5 transition #{resource_module.card_classes}" do %>
      <p class="text-xs font-medium uppercase tracking-wide <%= dark ? 'text-white/60' : 'text-brand-primary/50' %>">
        <%= resource_module.number %>
      </p>
      <h3 class="mt-2 text-base font-bold <%= dark ? 'text-white' : 'text-brand-primary' %>">
        <%= resource_module_label(resource_module) %>
      </h3>
      <p class="mt-2 text-xs leading-relaxed <%= dark ? 'text-white/70' : 'text-brand-primary/70' %>">
        <%= t(resource_module.lead_i18n_key) %>
      </p>
    <% end %>
  <% end %>
</div>
