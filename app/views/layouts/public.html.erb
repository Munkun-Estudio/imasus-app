<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || site_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= site_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= render "layouts/social_meta" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "layouts/plausible_analytics" %>
    <%= render "layouts/brand_theme" %>

    <%= yield :head %>

    <%= render "layouts/brand_icons" %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "trix", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-white">
    <header class="border-b border-brand-primary/10 bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 sm:px-10">
        <%= link_to root_path, class: "inline-flex items-center" do %>
          <%= brand_logo_tag class: "h-9 w-auto font-bold text-brand-primary" %>
        <% end %>
      </div>
    </header>

    <main>
      <%= yield %>
    </main>

    <%= render "shared/footer", sidebar_offset: false %>
  </body>
</html>
